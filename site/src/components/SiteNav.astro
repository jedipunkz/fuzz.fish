---
import { links } from '../lib/content';

const base = import.meta.env.BASE_URL;

const nav = [
  ['#modes', 'Modes'],
  ['#keys', 'Keys'],
  ['#install', 'Install'],
  ['#contribute', 'Contribute'],
];
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={base} aria-label="fuzz.fish home">
      <img src={`${base}assets/fuzz.png`} alt="" width="32" height="32" />
      <span>fuzz<span class="nav__dot">.</span>fish</span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <a class="nav__repo" href={links.repo} rel="noopener">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.19c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
        ></path>
      </svg>
      <span>GitHub</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: rgb(22 22 30 / 78%);
    backdrop-filter: blur(14px);
  }

  .nav__inner {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
  }

  .nav__brand {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav__brand img {
    border-radius: 7px;
  }

  .nav__dot {
    color: var(--magenta);
  }

  .nav__links {
    display: flex;
    gap: 26px;
    margin-inline-start: auto;
  }

  .nav__links a {
    position: relative;
    color: var(--ink-dim);
    font-size: 0.92rem;
    font-weight: 550;
    text-decoration: none;
    transition: color 140ms ease;
  }

  .nav__links a:hover {
    color: var(--ink);
  }

  .nav__links a::after {
    position: absolute;
    right: 0;
    bottom: -6px;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transition: transform 160ms ease;
    content: "";
  }

  .nav__links a:hover::after {
    transform: scaleX(1);
  }

  .nav__repo {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      background-color 140ms ease;
  }

  .nav__repo:hover {
    border-color: var(--blue);
    background: rgb(122 162 247 / 12%);
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
  }
</style>
