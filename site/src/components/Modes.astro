---
import { modes } from '../lib/content';
---

<section class="section" id="modes" aria-labelledby="modes-title">
  <div class="container">
    <div class="section__head">
      <div>
        <p class="eyebrow">Five modes, one picker</p>
        <h2 id="modes-title">Switch context without switching tools</h2>
      </div>
      <p class="section-lead">
        The finder opens on history and stays open while you change modes. The current query carries
        over, so a search that started as a command can end as a file, a branch, or a commit.
      </p>
    </div>

    <ul class="modes">
      {modes.map((mode) => (
        <li class:list={['mode', `mode--${mode.accent}`]}>
          <div class="mode__head">
            <kbd>{mode.key}</kbd>
            <span class="mode__name">{mode.name}</span>
          </div>
          <h3>{mode.title}</h3>
          <p>{mode.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px 48px;
    align-items: end;
    margin-bottom: 36px;
  }

  .section__head .section-lead {
    margin-top: 0;
  }

  .modes {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  /* 3 cards, then 2 wider ones: keeps five items from leaving an orphan. */
  .mode:nth-child(-n + 3) {
    grid-column: span 2;
  }

  .mode:nth-child(n + 4) {
    grid-column: span 3;
  }

  .mode {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgb(31 35 53 / 90%), rgb(26 27 38 / 90%));
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .mode:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .mode__head {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .mode__head kbd {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    color: var(--accent);
  }

  .mode__name {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mode h3 {
    color: var(--ink);
  }

  .mode p {
    color: var(--ink-dim);
    font-size: 0.95rem;
  }

  .mode--blue {
    --accent: var(--blue);
  }

  .mode--green {
    --accent: var(--green);
  }

  .mode--magenta {
    --accent: var(--magenta);
  }

  .mode--cyan {
    --accent: var(--cyan);
  }

  .mode--orange {
    --accent: var(--orange);
  }

  @media (max-width: 980px) {
    .section__head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .modes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mode:nth-child(-n + 3),
    .mode:nth-child(n + 4) {
      grid-column: span 1;
    }
  }

  @media (max-width: 620px) {
    .modes {
      grid-template-columns: 1fr;
    }
  }
</style>
