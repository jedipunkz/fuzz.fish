---
/*
 * Static recreation of the fuzz.fish TUI in history mode. The colors mirror
 * internal/ui/styles.go so the page and the binary show the same palette.
 */
const rows = [
  { cmd: 'go test ./internal/app/...', time: '2m', hits: [] as string[] },
  { cmd: 'git commit --amend --no-edit', time: '8m', hits: ['git', 'com'], selected: true },
  { cmd: 'git commit -m "fix: keep the cursor in range"', time: '1h', hits: ['git', 'com'] },
  { cmd: 'git switch -c fix/preview-cache', time: '3h', hits: ['git'] },
  { cmd: 'go build -o fuzz ./cmd/fuzz', time: '5h', hits: [] },
  { cmd: 'git push -u origin fix/preview-cache', time: '1d', hits: ['git'] },
];

function segments(cmd: string, hits: string[]) {
  if (hits.length === 0) {
    return [{ text: cmd, hit: false }];
  }

  const pattern = new RegExp(`(${hits.join('|')})`, 'g');

  return cmd
    .split(pattern)
    .filter((part) => part !== '')
    .map((part) => ({ text: part, hit: hits.includes(part) }));
}
---

<div
  class="tui"
  role="img"
  aria-label="fuzz.fish in history mode: the query git com narrows the command list, and the preview pane shows when and where the selected command ran."
>
  <div class="tui__panes">
    <div class="tui__pane">
      {rows.map((row) => (
        <div class:list={['row', row.selected && 'row--selected']}>
          <span class="row__cursor">{row.selected ? '│' : ' '}</span>
          <span class="row__cmd">
            {segments(row.cmd, row.hits).map((part) =>
              part.hit ? <span class="row__hit">{part.text}</span> : <span>{part.text}</span>,
            )}
          </span>
          <span class="row__time">{row.time} ago</span>
        </div>
      ))}
    </div>

    <div class="tui__pane tui__pane--preview">
      <p class="label">Time</p>
      <p class="value">2026-09-21 09:41:02</p>
      <p class="value">8 minutes ago</p>
      <p class="label label--gap">Directory</p>
      <p class="value">~/src/fuzz.fish</p>
      <p class="context">Context</p>
      <p class="value context__line">&nbsp;&nbsp;go test ./internal/app/...</p>
      <p class="context__active">→ git commit --amend --no-edit</p>
      <p class="value context__line">&nbsp;&nbsp;git add internal/app/view.go</p>
    </div>
  </div>

  <div class="tui__input">
    <span class="tui__prompt">&gt;</span>
    <span class="tui__query">git com</span>
    <span class="tui__caret"></span>
  </div>
</div>

<style>
  .tui {
    --tui-border: #565f89;
    --tui-selection: #414868;
    --tui-hit: #f7768e;

    display: grid;
    gap: 6px;
    padding: 14px;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: clamp(0.66rem, 0.92vw, 0.8rem);
    line-height: 1.7;
  }

  .tui__panes {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 6px;
  }

  .tui__pane {
    display: grid;
    align-content: end;
    min-width: 0;
    padding: 6px 8px;
    border: 1px solid var(--tui-border);
    border-radius: 8px;
  }

  .tui__pane--preview {
    display: grid;
    align-content: start;
  }

  .row {
    display: grid;
    grid-template-columns: 1ch minmax(0, 1fr) auto;
    gap: 0 6px;
    align-items: center;
    padding-right: 4px;
    color: var(--ink);
    white-space: nowrap;
  }

  .row__cmd {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row--selected {
    border-radius: 4px;
    background: var(--tui-selection);
    color: var(--cyan);
    font-weight: 700;
  }

  .row__cursor {
    color: var(--magenta);
  }

  .row__hit {
    color: var(--tui-hit);
    font-weight: 700;
  }

  .row__time {
    color: var(--blue);
  }

  .label {
    color: var(--magenta);
  }

  .label--gap {
    margin-top: 1.2em;
  }

  .value {
    overflow: hidden;
    color: var(--ink);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .context {
    margin-top: 1.2em;
    color: var(--yellow);
    font-weight: 700;
  }

  .context__line {
    color: var(--ink-dim);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .context__active {
    overflow: hidden;
    color: var(--orange);
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tui__input {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 4px 10px;
    border: 1px solid var(--tui-border);
    border-radius: 8px;
  }

  .tui__prompt {
    color: var(--cyan);
  }

  .tui__query {
    color: var(--ink);
  }

  .tui__caret {
    width: 0.62em;
    height: 1.15em;
    background: var(--ink);
    animation: blink 1.1s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tui__caret {
      animation: none;
    }
  }

  @media (max-width: 620px) {
    .tui__panes {
      grid-template-columns: 1fr;
    }

    .tui__pane--preview {
      display: none;
    }
  }
</style>
